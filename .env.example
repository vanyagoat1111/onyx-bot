# ONYX bot — переменные окружения.
# Реальные значения задаются в Vercel: Project → Settings → Environment Variables.
# Этот файл — образец. Настоящих секретов здесь быть не должно.

# ─────────────────── Обязательные ───────────────────

# Токен бота от @BotFather. Самый ценный секрет: даёт доступ ко всей переписке
# со всеми клиентами. При подозрении на утечку — сразу /revoke у BotFather.
BOT_TOKEN=

# Telegram ID администраторов через запятую. Узнать свой: @userinfobot
ADMIN_TELEGRAM_IDS=

# ─────────────────── Безопасность ───────────────────
# Без этих трёх переменных часть защиты выключается. Бот об этом предупредит
# в логе при старте и сообщением в админ-чат.

# Секрет вебхука. Telegram присылает его в заголовке при каждом апдейте, и это
# единственный способ отличить настоящий апдейт от подделки. Без него бот
# отключает все административные функции.
# Сгенерировать:  openssl rand -hex 32
# Зарегистрировать вебхук с секретом:
#   curl -F "url=https://ВАШ-ДОМЕН/telegram" -F "secret_token=ЗНАЧЕНИЕ" \
#        https://api.telegram.org/botТОКЕН/setWebhook
WEBHOOK_SECRET=

# Секрет планировщика. Vercel сам подставляет его в заголовок Authorization
# для задач из vercel.json. Без него плановые задачи не выполняются — это
# защита от того, чтобы посторонний запускал рассылку по всей базе.
CRON_SECRET=

# Общий секрет со скриптом Google. Тот же самой строкой пропишите в
# Apps Script → Настройки проекта → Свойства скрипта → SHARED_SECRET
SHEETS_SECRET=

# ─────────────────── Хранилище ───────────────────

KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─────────────────── Google ───────────────────

# Адрес веб-приложения Apps Script (…/exec). Сам по себе является секретом:
# кто знает адрес, тот может писать в таблицы, если не задан SHEETS_SECRET.
SHEETS_WEBHOOK_URL=

# ─────────────────── Необязательные ───────────────────

# Базовый адрес для картинок и чек-листа. Если пусто, берётся из переменных
# Vercel автоматически.
PUBLIC_BASE_URL=

BOT_USERNAME=onyxwebsites_bot
SITE_URL=https://onyx-web.ru
MANAGER_USERNAME=
MANAGER_CHAT_ID=
ONYX_PHONE=
ONYX_EMAIL=

# file_id голосового объяснения модели. Получается командой /voiceid.
MODEL_VOICE_FILE_ID=

# Ключ ИИ-провайдера для текстов аудита. Без него аудит работает на правилах.
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# Карточки тарифов: 1 — анимированные, 0 — статичные картинки.
TARIFF_ANIMATED=0
RICH_TEXT=1
